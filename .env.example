# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public origin of this API (no trailing /api/v1). Used for OAuth callbacks in production.
API_PUBLIC_URL=https://errands-backend-api-gya2cva0bmeub7ae.southafricanorth-01.azurewebsites.net

# ─── Database ─────────────────────────────────────────────────────────────────
# Local `npm run dev` (NODE_ENV=development) uses DATABASE_URL.
# Azure App Service (NODE_ENV=production) uses DATABASE_URL from App Settings.
DATABASE_URL="postgresql://errands:errands_dev_password@localhost:5432/errands_dev"
DATABASE_URL_PRODUCTION="postgresql://errands_admin:PASSWORD@errands-backend-db.postgres.database.azure.com:5432/postgres?sslmode=require"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Azure Managed Redis: rediss://:ACCESS_KEY@errands-backend-redis2.southafricanorth.redis.azure.net:10000
REDIS_URL=redis://:errands_redis_password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=errands_redis_password
REDIS_TLS=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-different-256-bit-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS / client apps ───────────────────────────────────────────────────────
# Local: any localhost / 127.0.0.1 port is allowed in code (Admin :3001, website :3000, Expo web :8081).
# Native mobile (ERRANDS-mobile) does not send Origin — those requests are allowed.
# When you deploy Admin / the website, add those https origins here and in Azure App Settings.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=https://admin.errandss.co.za
# Mobile deep link for password-reset emails in production; use a public web URL if preferred.
PASSWORD_RESET_URL=errands://auth/reset-password
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:8081,https://errands-admin.netlify.app,https://admin.errandss.co.za

# ─── Email (SendGrid SMTP) ────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=replace-with-sendgrid-api-key
EMAIL_FROM="E-RRANDS <info@techxm.co.za>"

# Set to "true" to log email/phone OTP codes (visible in Azure Log Stream) when
# no real SMTP/SMS provider is configured. Independent of NODE_ENV — remove once
# real delivery (e.g. SendGrid) is set up.
OTP_DEBUG_LOG=false

# ─── Africa's Talking (SMS / OTP) ─────────────────────────────────────────────
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_USERNAME=your-username
AFRICASTALKING_SENDER_ID=E-RRANDS

# ─── Cloudinary (file uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── PayFast ──────────────────────────────────────────────────────────────────
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_SANDBOX=true
PAYFAST_RETURN_URL=http://localhost:3000/payment/success
PAYFAST_CANCEL_URL=http://localhost:3000/payment/cancel
PAYFAST_NOTIFY_URL=https://errands-backend-api-gya2cva0bmeub7ae.southafricanorth-01.azurewebsites.net/api/v1/payments/payfast/itn

# ─── Stripe (international fallback) ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_RETURN_URL=http://localhost:3000/api/v1/payments/stripe/return
STRIPE_CANCEL_URL=http://localhost:3000/api/v1/payments/stripe/cancel

# ─── Sumsub (KYC — DEPRECATED, replaced by Didit below) ───────────────────────
# No longer used to mint new tokens (ProvidersModule now uses DiditService).
# Kept registered only so any applicant still mid-review through Sumsub at
# cutover still gets their webhook result recorded. Safe to delete once no
# such applicants remain.
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=sbx:your-app-token
SUMSUB_SECRET_KEY=your-secret-key
SUMSUB_LEVEL_NAME=id-and-liveness
# Separate secret generated per-webhook in Dashboard -> Integrations -> Webhooks.
SUMSUB_WEBHOOK_SECRET=your-webhook-secret

# ─── Didit (KYC — provider identity verification) ─────────────────────────────
DIDIT_VERIFICATION_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=your-didit-api-key
# Created via POST /v3/workflows/ — see src/modules/didit/didit.service.ts.
DIDIT_WORKFLOW_ID=your-workflow-id
# Generated when the webhook destination was registered (POST
# /v3/webhook/destinations/). Used only to verify inbound webhook signatures.
DIDIT_WEBHOOK_SECRET=your-webhook-secret
# Where Didit's hosted page redirects after the user finishes/abandons the
# flow. Reuses the mobile app's registered custom URL scheme (MOBILE_APP_SCHEME).
DIDIT_CALLBACK_URL=errands://kyc/callback

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://errands-backend-api-gya2cva0bmeub7ae.southafricanorth-01.azurewebsites.net/api/v1/auth/google/callback

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://errands-backend-api-gya2cva0bmeub7ae.southafricanorth-01.azurewebsites.net/api/v1/auth/facebook/callback

# Native Sign in with Apple (iOS). APPLE_BUNDLE_ID must equal the app's bundle
# identifier — it is the `aud` claim the identity token is verified against.
# APPLE_TEAM_ID is only needed later for server-side token revocation on account
# deletion.
APPLE_BUNDLE_ID=co.za.errands.app
APPLE_TEAM_ID=your-apple-team-id

# Custom URL scheme the Expo mobile app registers for deep-link callbacks (must match app.json's "scheme")
MOBILE_APP_SCHEME=errands

# ─── Business Rules (OI-1: confirm commission rate with client) ────────────────
COMMISSION_RATE=0.15
MINIMUM_WITHDRAWAL=100

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0

# ─── Admin seed ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@e-rrands.co.za
ADMIN_PASSWORD=Admin@123!
